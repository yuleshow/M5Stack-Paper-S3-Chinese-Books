// ── Utility functions ──────────────────────────────────────────────────

// Extract a query-string parameter value (URL-decoded) into dst.
static bool getQueryParam(const char* query, const char* key,
                          char* dst, int maxLen) {
  if (!query || !key) { dst[0] = '\0'; return false; }
  int klen = strlen(key);
  const char* p = query;
  while (*p) {
    if (strncmp(p, key, klen) == 0 && p[klen] == '=') {
      const char* val = p + klen + 1;
      const char* end = strchr(val, '&');
      if (!end) end = val + strlen(val);
      int i = 0;
      while (val < end && i < maxLen - 1) {
        if (*val == '%' && val + 2 <= end) {
          char hex[3] = {val[1], val[2], 0};
          dst[i++] = (char)strtol(hex, NULL, 16);
          val += 3;
        } else if (*val == '+') {
          dst[i++] = ' '; val++;
        } else {
          dst[i++] = *val++;
        }
      }
      dst[i] = '\0';
      return true;
    }
    const char* nxt = strchr(p, '&');
    if (!nxt) break;
    p = nxt + 1;
  }
  dst[0] = '\0';
  return false;
}

// Escape a C string for JSON into dst, returns length written.
static int jsonEscape(char* dst, int maxLen, const char* src) {
  int i = 0;
  while (*src && i < maxLen - 2) {
    char c = *src++;
    if (c == '"')       { if (i + 2 > maxLen - 1) break; dst[i++] = '\\'; dst[i++] = '"'; }
    else if (c == '\\') { if (i + 2 > maxLen - 1) break; dst[i++] = '\\'; dst[i++] = '\\'; }
    else if (c == '\n') { if (i + 2 > maxLen - 1) break; dst[i++] = '\\'; dst[i++] = 'n'; }
    else if (c == '\r') { if (i + 2 > maxLen - 1) break; dst[i++] = '\\'; dst[i++] = 'r'; }
    else if ((uint8_t)c >= 0x20) { dst[i++] = c; }
  }
  dst[i] = '\0';
  return i;
}

// Path safety: reject path traversal
static bool isValidPath(const char* p) {
  if (!p || p[0] != '/') return false;
  if (strstr(p, "..")) return false;
  return true;
}

// ── HTTP response helpers ──────────────────────────────────────────────

static void sendHeaders(WiFiClient& c, int code, const char* ctype,
                        int contentLen = -1) {
  const char* reason = "OK";
  if (code == 400) reason = "Bad Request";
  else if (code == 404) reason = "Not Found";
  else if (code == 202) reason = "Accepted";
  else if (code == 204) reason = "No Content";
  else if (code == 500) reason = "Internal Server Error";
  c.printf("HTTP/1.1 %d %s\r\n", code, reason);
  c.printf("Content-Type: %s\r\n", ctype);
  if (contentLen >= 0) c.printf("Content-Length: %d\r\n", contentLen);
  c.print("Connection: close\r\nCache-Control: no-store\r\n\r\n");
}

static void sendPlain(WiFiClient& c, int code, const char* body) {
  int len = strlen(body);
  sendHeaders(c, code, "text/plain", len);
  c.write((const uint8_t*)body, len);
}

static void sendJson(WiFiClient& c, int code, const char* json) {
  int len = strlen(json);
  sendHeaders(c, code, "application/json", len);
  c.write((const uint8_t*)json, len);
}

// ── HTTP request parsing ───────────────────────────────────────────────

struct HttpReq {
  char method[8];
  char path[128];
  char query[256];
  int  contentLen;
};

static bool readLine(WiFiClient& c, char* buf, int maxLen) {
  int i = 0;
  unsigned long t0 = millis();
  while (i < maxLen - 1 && millis() - t0 < 5000) {
    if (c.available()) {
      char ch = c.read();
      if (ch == '\n') break;
      if (ch != '\r') buf[i++] = ch;
      t0 = millis();
    } else {
      yield();
    }
  }
  buf[i] = '\0';
  return i > 0 || (millis() - t0 < 5000);
}

static bool parseRequest(WiFiClient& c, HttpReq* req) {
  memset(req, 0, sizeof(HttpReq));
  req->contentLen = -1;

  char line[512];
  if (!readLine(c, line, sizeof(line))) return false;
  if (line[0] == '\0') return false;

  // Parse method
  char* sp1 = strchr(line, ' ');
  if (!sp1) return false;
  int mlen = min((int)(sp1 - line), (int)(sizeof(req->method) - 1));
  memcpy(req->method, line, mlen);
  req->method[mlen] = '\0';

  // Parse URI
  char* uri = sp1 + 1;
  char* sp2 = strchr(uri, ' ');
  if (sp2) *sp2 = '\0';

  char* qmark = strchr(uri, '?');
  if (qmark) {
    *qmark = '\0';
    strncpy(req->query, qmark + 1, sizeof(req->query) - 1);
  }
  strncpy(req->path, uri, sizeof(req->path) - 1);

  // Read headers, extract Content-Length
  while (true) {
    char hdr[256];
    readLine(c, hdr, sizeof(hdr));
    if (hdr[0] == '\0') break;
    if (strncasecmp(hdr, "Content-Length:", 15) == 0) {
      req->contentLen = atoi(hdr + 15);
    }
  }
  return true;
}

// ── API: Directory listing ─────────────────────────────────────────────

static void apiLs(WiFiClient& c, const char* query) {
  char dirPath[256];
  if (!getQueryParam(query, "dir", dirPath, sizeof(dirPath)) || dirPath[0] == '\0') {
    strcpy(dirPath, "/");
  }
  if (!isValidPath(dirPath)) { sendPlain(c, 400, "invalid path"); return; }

  int dlen = strlen(dirPath);
  if (dlen > 0 && dirPath[dlen - 1] != '/' && dlen < (int)sizeof(dirPath) - 1) {
    dirPath[dlen] = '/'; dirPath[dlen + 1] = '\0';
  }

  // Free reader caches if heap is low
  if (ESP.getFreeHeap() < 15000) {
    Serial.printf("[web] heap low (%u), freeing reader caches\n", (unsigned)ESP.getFreeHeap());
    freeGlyphCache();
    unloadBinaryFont();
    if (epubFullText) { free(epubFullText); epubFullText = nullptr; epubFullTextLen = 0; }
  }

  // SD library needs path without trailing slash (except root)
  char openPath[256];
  strncpy(openPath, dirPath, sizeof(openPath));
  int olen = strlen(openPath);
  if (olen > 1 && openPath[olen - 1] == '/') openPath[olen - 1] = '\0';

  sendHeaders(c, 200, "application/json");
  c.print("{\"f\":[");

  bool first = true;
  {
    ScopedSDLock lock;
    File dir = SD.open(openPath);
    if (dir && dir.isDirectory()) {
      File entry = dir.openNextFile();
      while (entry) {
        yield();
        esp_task_wdt_reset();
        String rawName = String(entry.name());
        int sl = rawName.lastIndexOf('/');
        String entryName = (sl >= 0) ? rawName.substring(sl + 1) : rawName;

        if (entryName.length() > 0) {
          char escaped[192];
          jsonEscape(escaped, sizeof(escaped), entryName.c_str());
          char buf[280];
          int n = snprintf(buf, sizeof(buf),
                           "%s{\"n\":\"%s\",\"s\":%lu,\"d\":%s}",
                           first ? "" : ",",
                           escaped,
                           (unsigned long)entry.size(),
                           entry.isDirectory() ? "true" : "false");
          c.write((const uint8_t*)buf, n);
          first = false;
        }
        entry.close();
        entry = dir.openNextFile();
      }
      dir.close();
    }
  }

  c.print("]}");
}

// ── API: File download ─────────────────────────────────────────────────

static void apiDl(WiFiClient& c, const char* query) {
  char filepath[256];
  if (!getQueryParam(query, "f", filepath, sizeof(filepath))) {
    sendPlain(c, 400, "missing f param"); return;
  }
  if (!isValidPath(filepath)) { sendPlain(c, 400, "invalid path"); return; }

  ScopedSDLock lock;
  File file = SD.open(filepath, FILE_READ);
  if (!file || file.isDirectory()) {
    sendPlain(c, 404, "not found"); return;
  }

  size_t fileSize = file.size();

  const char* ct = "application/octet-stream";
  if (strstr(filepath, ".txt")) ct = "text/plain";
  else if (strstr(filepath, ".htm")) ct = "text/html";
  else if (strstr(filepath, ".css")) ct = "text/css";
  else if (strstr(filepath, ".js"))  ct = "application/javascript";
  else if (strstr(filepath, ".json")) ct = "application/json";
  else if (strstr(filepath, ".jpg") || strstr(filepath, ".jpeg")) ct = "image/jpeg";
  else if (strstr(filepath, ".png")) ct = "image/png";
  else if (strstr(filepath, ".pdf")) ct = "application/pdf";

  const char* fname = strrchr(filepath, '/');
  fname = fname ? fname + 1 : filepath;

  c.printf("HTTP/1.1 200 OK\r\n"
           "Content-Type: %s\r\n"
           "Content-Length: %u\r\n"
           "Content-Disposition: attachment; filename=\"%s\"\r\n"
           "Connection: close\r\n\r\n",
           ct, (unsigned)fileSize, fname);

  uint8_t buf[1024];
  while (file.available() && c.connected()) {
    int n = file.read(buf, sizeof(buf));
    if (n > 0) c.write(buf, n);
    yield();
    esp_task_wdt_reset();
  }
  file.close();
  Serial.printf("[web] download: %s (%u bytes)\n", filepath, (unsigned)fileSize);
}

// ── API: File upload (PUT with raw body) ───────────────────────────────

static void apiUp(WiFiClient& c, const char* query, int contentLen) {
  char filepath[256];
  if (!getQueryParam(query, "f", filepath, sizeof(filepath))) {
    sendPlain(c, 400, "missing f param"); return;
  }
  if (!isValidPath(filepath)) { sendPlain(c, 400, "invalid path"); return; }
  if (contentLen <= 0) { sendPlain(c, 400, "missing content-length"); return; }

  Serial.printf("[web] upload start: %s (%d bytes)\n", filepath, contentLen);

  if (sdMutex) xSemaphoreTake(sdMutex, portMAX_DELAY);

  if (SD.exists(filepath)) SD.remove(filepath);
  File f = SD.open(filepath, FILE_WRITE);
  if (!f) {
    if (sdMutex) xSemaphoreGive(sdMutex);
    sendPlain(c, 500, "cannot open file");
    return;
  }

  uint8_t buf[512];
  int remaining = contentLen;
  unsigned long lastData = millis();
  bool ok = true;

  while (remaining > 0 && c.connected()) {
    int toRead = min(remaining, (int)sizeof(buf));
    int got = c.read(buf, toRead);
    if (got > 0) {
      size_t written = f.write(buf, got);
      if ((int)written != got) {
        Serial.printf("[web] upload write error: wanted %d, wrote %u\n", got, (unsigned)written);
        ok = false; break;
      }
      remaining -= got;
      lastData = millis();
    } else {
      if (millis() - lastData > 15000) { ok = false; break; }
      delay(1);
    }
    esp_task_wdt_reset();
  }

  f.flush();
  size_t finalSize = f.size();
  f.close();
  if (sdMutex) xSemaphoreGive(sdMutex);

  if (ok && remaining == 0) {
    char resp[64];
    snprintf(resp, sizeof(resp), "{\"ok\":true,\"s\":%u}", (unsigned)finalSize);
    sendJson(c, 200, resp);
    Serial.printf("[web] upload done: %s (%u bytes)\n", filepath, (unsigned)finalSize);
  } else {
    ScopedSDLock lock;
    SD.remove(filepath);
    sendPlain(c, 500, "upload failed");
    Serial.printf("[web] upload FAILED: %s (remaining=%d)\n", filepath, remaining);
  }
}

// ── API: Delete file ───────────────────────────────────────────────────

static void apiRm(WiFiClient& c, const char* query) {
  char filepath[256];
  if (!getQueryParam(query, "f", filepath, sizeof(filepath))) {
    sendPlain(c, 400, "missing f param"); return;
  }
  if (!isValidPath(filepath)) { sendPlain(c, 400, "invalid path"); return; }

  Serial.printf("[web] delete: %s\n", filepath);

  bool existed = false, isDir = false, ok = false;
  {
    ScopedSDLock lock;
    existed = SD.exists(filepath);
    if (existed) {
      File f = SD.open(filepath);
      if (f) { isDir = f.isDirectory(); f.close(); }
      ok = isDir ? SD.rmdir(filepath) : SD.remove(filepath);
    }
  }

  if (!existed) { sendJson(c, 404, "{\"ok\":false,\"e\":\"not found\"}"); return; }
  if (ok) { sendJson(c, 200, "{\"ok\":true}"); }
  else    { sendJson(c, 500, "{\"ok\":false,\"e\":\"delete failed\"}"); }
}

// ── API: Health ────────────────────────────────────────────────────────

static void apiHealth(WiFiClient& c) {
  char buf[256];
  snprintf(buf, sizeof(buf),
           "heap=%u  psram=%u  wifi=%d  mode=%d  uptime=%lus",
           (unsigned)ESP.getFreeHeap(),
           (unsigned)ESP.getFreePsram(),
           (int)WiFi.status(),
           (int)currentMode,
           millis() / 1000UL);
  sendPlain(c, 200, buf);
}

// ── Screen Capture ─────────────────────────────────────────────────────

static uint8_t* cachedBmp = nullptr;
static volatile bool captureRequested = false;
static bool captureReady = false;
static bool captureInProgress = false;
static int captureY = 0;
static uint8_t* captureRgbChunk = nullptr;
static unsigned long captureStartTime = 0;

static const int SCR_W = 540;
static const int SCR_H = 960;
static const int SCR_STRIDE = (SCR_W + 3) & ~3;
static const int CAPTURE_CHUNK = 32;
static const int BMP_HDR_SZ = 14 + 40;
static const int BMP_PAL_SZ = 256 * 4;
static const int BMP_IMG_SZ = SCR_STRIDE * SCR_H;
static const int BMP_TOTAL  = BMP_HDR_SZ + BMP_PAL_SZ + BMP_IMG_SZ;

static bool initScreenBuffer() {
  if (cachedBmp) return true;
  cachedBmp = (uint8_t*)ps_malloc(BMP_TOTAL);
  if (!cachedBmp) {
    sdLog("Screenshot: PSRAM alloc failed (%d bytes, free=%u)",
          BMP_TOTAL, (unsigned)ESP.getFreePsram());
    return false;
  }
  memset(cachedBmp, 0, BMP_HDR_SZ);
  cachedBmp[0] = 'B'; cachedBmp[1] = 'M';
  *(uint32_t*)(cachedBmp + 2)  = BMP_TOTAL;
  *(uint32_t*)(cachedBmp + 10) = BMP_HDR_SZ + BMP_PAL_SZ;
  *(uint32_t*)(cachedBmp + 14) = 40;
  *(int32_t*)(cachedBmp + 18)  = SCR_W;
  *(int32_t*)(cachedBmp + 22)  = SCR_H;
  *(uint16_t*)(cachedBmp + 26) = 1;
  *(uint16_t*)(cachedBmp + 28) = 8;
  *(uint32_t*)(cachedBmp + 34) = BMP_IMG_SZ;
  *(int32_t*)(cachedBmp + 38)  = 2835;
  *(int32_t*)(cachedBmp + 42)  = 2835;
  *(uint32_t*)(cachedBmp + 46) = 256;
  for (int i = 0; i < 256; i++) {
    cachedBmp[BMP_HDR_SZ + i * 4]     = i;
    cachedBmp[BMP_HDR_SZ + i * 4 + 1] = i;
    cachedBmp[BMP_HDR_SZ + i * 4 + 2] = i;
    cachedBmp[BMP_HDR_SZ + i * 4 + 3] = 0;
  }
  memset(cachedBmp + BMP_HDR_SZ + BMP_PAL_SZ, 0xFF, BMP_IMG_SZ);
  sdLog("Screenshot: BMP buffer allocated (%d bytes PSRAM)", BMP_TOTAL);
  return true;
}

static void freeScreenBuffer() {
  if (captureRgbChunk) { free(captureRgbChunk); captureRgbChunk = nullptr; }
  captureInProgress = false;
  captureY = 0;
  if (cachedBmp) {
    free(cachedBmp); cachedBmp = nullptr;
    captureReady = false; captureRequested = false;
  }
}

void updateScreenCapture() {
  if (!cachedBmp) return;
  if (captureRequested && !captureInProgress) {
    captureRequested = false;
    if (M5.Display.displayBusy()) { captureRequested = true; return; }
    captureRgbChunk = (uint8_t*)ps_malloc(SCR_W * 3 * CAPTURE_CHUNK);
    if (!captureRgbChunk) {
      sdLog("Capture: rgbChunk alloc failed psram=%u", (unsigned)ESP.getFreePsram());
      return;
    }
    captureInProgress = true; captureY = 0;
    captureStartTime = millis();
    sdLog("Capture: start heap=%u psram=%u", (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getFreePsram());
  }
  if (!captureInProgress) return;
  int rows = min(CAPTURE_CHUNK, SCR_H - captureY);
  M5.Display.readRectRGB(0, captureY, SCR_W, rows, captureRgbChunk);
  uint8_t* pixels = cachedBmp + BMP_HDR_SZ + BMP_PAL_SZ;
  for (int r = 0; r < rows; r++) {
    int bmpRow = SCR_H - 1 - (captureY + r);
    uint8_t* src = captureRgbChunk + r * SCR_W * 3;
    uint8_t* dst = pixels + bmpRow * SCR_STRIDE;
    for (int x = 0; x < SCR_W; x++)
      dst[x] = (uint8_t)((src[x*3]*77 + src[x*3+1]*150 + src[x*3+2]*29) >> 8);
  }
  esp_task_wdt_reset();
  captureY += rows;
  if (captureY >= SCR_H) {
    free(captureRgbChunk); captureRgbChunk = nullptr;
    captureInProgress = false; captureReady = true;
    sdLog("Capture: done %lu ms", millis() - captureStartTime);
  }
}

static void serveBmp(WiFiClient& c) {
  c.printf("HTTP/1.1 200 OK\r\n"
           "Content-Type: image/bmp\r\n"
           "Content-Length: %d\r\n"
           "Connection: close\r\n\r\n", BMP_TOTAL);
  int sent = 0;
  while (sent < BMP_TOTAL && c.connected()) {
    int chunk = min(4096, BMP_TOTAL - sent);
    size_t written = c.write(cachedBmp + sent, chunk);
    if (written == 0) break;
    sent += written;
    yield();
  }
  Serial.printf("[web] screenshot served %d/%d bytes\n", sent, BMP_TOTAL);
}

static void apiScreen(WiFiClient& c, const char* query) {
  sdLog("Screenshot: req ready=%d prog=%d y=%d heap=%u psram=%u",
        (int)captureReady, (int)captureInProgress, captureY,
        (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getFreePsram());

  char tmp[8];
  if (getQueryParam(query, "test", tmp, sizeof(tmp))) {
    if (!cachedBmp && !initScreenBuffer()) {
      sendPlain(c, 500, "alloc failed"); return;
    }
    uint8_t* pixels = cachedBmp + BMP_HDR_SZ + BMP_PAL_SZ;
    for (int y = 0; y < SCR_H; y++) {
      uint8_t gray = (uint8_t)((y * 255) / SCR_H);
      memset(pixels + (SCR_H - 1 - y) * SCR_STRIDE, gray, SCR_W);
    }
    captureReady = true;
    serveBmp(c);
    return;
  }

  if (cachedBmp && captureReady) {
    serveBmp(c);
    captureReady = false;
    captureRequested = true;
    return;
  }

  if (captureInProgress) {
    char buf[32];
    snprintf(buf, sizeof(buf), "capturing %d%%", captureY * 100 / SCR_H);
    sendPlain(c, 202, buf);
    return;
  }

  if (cachedBmp || initScreenBuffer()) {
    captureRgbChunk = (uint8_t*)ps_malloc(SCR_W * 3 * CAPTURE_CHUNK);
    if (captureRgbChunk) {
      captureInProgress = true; captureY = 0;
      captureStartTime = millis();
      uint8_t* pixels = cachedBmp + BMP_HDR_SZ + BMP_PAL_SZ;
      for (int y = 0; y < SCR_H; y += CAPTURE_CHUNK) {
        int rows = min(CAPTURE_CHUNK, SCR_H - y);
        M5.Display.readRectRGB(0, y, SCR_W, rows, captureRgbChunk);
        for (int r = 0; r < rows; r++) {
          int bmpRow = SCR_H - 1 - (y + r);
          uint8_t* src = captureRgbChunk + r * SCR_W * 3;
          uint8_t* dst = pixels + bmpRow * SCR_STRIDE;
          for (int xx = 0; xx < SCR_W; xx++)
            dst[xx] = (uint8_t)((src[xx*3]*77 + src[xx*3+1]*150 + src[xx*3+2]*29) >> 8);
        }
        esp_task_wdt_reset(); yield();
      }
      free(captureRgbChunk); captureRgbChunk = nullptr;
      captureInProgress = false; captureReady = true; captureRequested = false;
      sdLog("Capture: blocking done %lu ms", millis() - captureStartTime);
      serveBmp(c);
      captureReady = false; captureRequested = true;
      return;
    }
  }
  sendPlain(c, 500, "no capture available");
}

// ── API: Debug log ─────────────────────────────────────────────────────

static void apiLog(WiFiClient& c) {
  ScopedSDLock lock;
  File f = SD.open("/debug.log", FILE_READ);
  if (!f) { sendPlain(c, 200, "(no log file yet)"); return; }
  sendHeaders(c, 200, "text/plain", f.size());
  uint8_t buf[512];
  while (f.available() && c.connected()) {
    int n = f.read(buf, sizeof(buf));
    if (n > 0) c.write(buf, n);
    yield();
  }
  f.close();
}

static void apiLogClear(WiFiClient& c) {
  { ScopedSDLock lock; SD.remove("/debug.log"); }
  sendPlain(c, 200, "ok");
}

// ── SD Card Debug Logger ───────────────────────────────────────────────

void sdLog(const char* fmt, ...) {
  char buf[256];
  va_list args;
  va_start(args, fmt);
  int len = vsnprintf(buf, sizeof(buf), fmt, args);
  va_end(args);
  if (len <= 0) return;

  Serial.printf("[LOG] %s\n", buf);
  if (!sdCardAvailable) return;

  char line[320];
  unsigned long ms = millis();
  unsigned long sec = ms / 1000;
  int h = (sec / 3600) % 24;
  int m = (sec / 60) % 60;
  int s = sec % 60;
  int lineLen = snprintf(line, sizeof(line), "[%02d:%02d:%02d.%03lu] %s\n",
                         h, m, s, ms % 1000, buf);

  File f = SD.open("/debug.log", FILE_APPEND);
  if (f) { f.write((const uint8_t*)line, lineLen); f.close(); }
}

// ── Serve static SPA ───────────────────────────────────────────────────

static void serveSPA(WiFiClient& c) {
  int len = sizeof(SPA_HTML) - 1;
  c.printf("HTTP/1.1 200 OK\r\n"
           "Content-Type: text/html; charset=utf-8\r\n"
           "Content-Length: %d\r\n"
           "Connection: close\r\n"
           "Cache-Control: no-store\r\n\r\n", len);
  int sent = 0;
  while (sent < len && c.connected()) {
    int chunk = min(1024, len - sent);
    size_t written = c.write((const uint8_t*)(SPA_HTML + sent), chunk);
    if (written == 0) break;
    sent += written;
    yield();
  }
}

// ── Main client handler ────────────────────────────────────────────────

void handleWebClients() {
  WiFiClient client = rawServer.available();
  if (!client) return;

  client.setNoDelay(true);
  client.setTimeout(5);

  HttpReq req;
  if (!parseRequest(client, &req)) {
    client.stop();
    return;
  }

  Serial.printf("[web] %s %s heap=%u\n", req.method, req.path, (unsigned)ESP.getFreeHeap());

  // Route request
  if (strcmp(req.path, "/") == 0 && strcmp(req.method, "GET") == 0) {
    serveSPA(client);
  }
  else if (strcmp(req.path, "/api/ls") == 0) {
    apiLs(client, req.query);
  }
  else if (strcmp(req.path, "/api/dl") == 0) {
    apiDl(client, req.query);
  }
  else if (strcmp(req.path, "/api/up") == 0 && strcmp(req.method, "PUT") == 0) {
    apiUp(client, req.query, req.contentLen);
  }
  else if (strcmp(req.path, "/api/rm") == 0) {
    apiRm(client, req.query);
  }
  else if (strcmp(req.path, "/api/health") == 0) {
    apiHealth(client);
  }
  else if (strcmp(req.path, "/api/screen") == 0) {
    apiScreen(client, req.query);
  }
  else if (strcmp(req.path, "/api/log") == 0) {
    apiLog(client);
  }
  else if (strncmp(req.path, "/api/log/clear", 14) == 0) {
    apiLogClear(client);
  }
  else if (strcmp(req.path, "/favicon.ico") == 0) {
    sendHeaders(client, 204, "text/plain", 0);
  }
  else {
    sendPlain(client, 404, "not found");
  }

  client.flush();
  client.stop();
}

// ── Start / Stop ───────────────────────────────────────────────────────

void startWebServer() {
  sdLog("startWebServer: WiFi.status=%d, heap=%u, psram=%u",
        (int)WiFi.status(), (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getFreePsram());

  if (WiFi.status() != WL_CONNECTED) {
    WiFi.mode(WIFI_AP_STA);
    WiFi.setSleep(false);
    if (!WiFi.softAP(WEB_AP_SSID, WEB_AP_PASS)) {
      Serial.println("Cannot start web server: WiFi AP start failed");
      webServerRunning = false;
      return;
    }
    webServerStartedAP = true;
    sdLog("startWebServer: fallback AP %s at %s", WEB_AP_SSID,
          WiFi.softAPIP().toString().c_str());
  }

  WiFi.setSleep(false);

  if (!rawServerStarted) {
    rawServer.begin();
    rawServerStarted = true;
  }

  webServerRunning = true;
  if (WiFi.status() == WL_CONNECTED) {
    sdLog("startWebServer: OK at %s", WiFi.localIP().toString().c_str());
  } else {
    sdLog("startWebServer: OK at AP %s", WiFi.softAPIP().toString().c_str());
  }
}

void stopWebServer() {
  if (rawServerStarted) {
    sdLog("stopWebServer: WiFi.status=%d", (int)WiFi.status());
    rawServer.end();
    rawServerStarted = false;
    freeScreenBuffer();
    Serial.println("Web server stopped");
  }
  if (webServerStartedAP) {
    WiFi.softAPdisconnect(true);
    webServerStartedAP = false;
    if (WiFi.status() != WL_CONNECTED) WiFi.mode(WIFI_STA);
  }
  webServerRunning = false;
}
