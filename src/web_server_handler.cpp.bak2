// ==================== Raw-Socket Web Server (SPA + JSON API) ====================
// Replaces the Arduino WebServer library with a direct WiFiServer/WiFiClient
// implementation.  All HTML/CSS/JS lives in flash (.rodata) — zero heap for UI.
// API responses use small stack buffers — no Arduino String objects in hot paths.
// File uploads use PUT with a raw binary body (no multipart parsing needed).
//
// Endpoints:
//   GET  /             → static SPA page (from flash)
//   GET  /api/ls       → JSON directory listing  (?dir=...)
//   GET  /api/dl       → file download           (?f=...)
//   PUT  /api/up       → file upload (raw body)   (?f=...)
//   GET  /api/rm       → delete file/dir          (?f=...)
//   GET  /api/health   → plain-text health info
//   GET  /api/screen   → BMP screenshot
//   GET  /api/log      → debug log text
//   GET  /api/log/clear→ clear debug log
// ========================================================================

#include "globals.h"
#include "esp_task_wdt.h"
#include <WiFiServer.h>
#include <WiFiClient.h>

// ── Constants ──────────────────────────────────────────────────────────
