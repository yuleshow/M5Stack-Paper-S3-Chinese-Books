// FreeRTOS mutex for SD card access
SemaphoreHandle_t sdMutex = NULL;

// RAII helper for SD card mutex - ensures lock is always released
struct ScopedSDLock {
  bool locked;
  ScopedSDLock() : locked(false) {
    if (sdMutex != NULL) {
      xSemaphoreTake(sdMutex, portMAX_DELAY);
      locked = true;
    }
  }
  ~ScopedSDLock() {
    if (locked && sdMutex != NULL) {
      xSemaphoreGive(sdMutex);
    }
  }
  // Non-copyable
  ScopedSDLock(const ScopedSDLock&) = delete;
  ScopedSDLock& operator=(const ScopedSDLock&) = delete;
};

